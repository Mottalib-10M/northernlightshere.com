---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/tonight/" title="Northern lights tonight: yes, maybe or no" width="100%" height="900" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the northern lights forecast on your site, free" description="Embed the northern lights tonight forecast on an astronomy club, observatory, lodge or newsroom site with one iframe line, free. Live SWPC and NWS data, no cookie, no tracking." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the forecast', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the forecast' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the forecast</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. The embedded tool reads the live feeds in each visitor's browser, so it is always current.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Useful for astronomy clubs, dark sky parks, lodges, local newsrooms and photography groups. Terms: keep the credit link under the tool visible, do not alter the frame, and present the answer as a forecast. The frame sets no cookie and sends nothing about your visitors to us. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/tonight/" title="Northern lights tonight: yes, maybe or no" width="100%" height="900" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
